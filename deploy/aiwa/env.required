# Names that /opt/seo/.env must define (non-empty). Checked by render-env.sh. Names only, never values.
# Derived from docs/cutover/2026-10-13-SCOPING-AUDIT.md section 6.1 and the env reads in each script.
# Service tags: mav=mav-bridge gbp=gbp-worker wk=weekly-run(new) mon=monitor wd=watchdog rec=reconcile fbc=fb-comment-agent ph=photo-sync

# --- core and pins (section 6.3: pin on AIWA, do not rely on code defaults)
TZ                          # all: must equal America/Chicago (checked by render-env.sh)
SUPABASE_URL                # mav gbp wk mon rec
SUPABASE_SERVICE_KEY        # mav gbp wk mon rec
SEO_PIPELINE                # wk mon wd: shadow during E, new from F (checked by render-env.sh)
SEO_AUTO_APPROVE            # wk wd: 0 during E, 1 from F
GBP_POSTER                  # mav gbp: api or playwright (checked by render-env.sh)
MAV_BRIDGE_GBP              # mav: off on AIWA
FB_BOOST_API                # mav: 0 in E, 1 in F

# --- Facebook and comments
FB_PAGE_ID                  # mav rec fbc
FB_PAGE_ACCESS_TOKEN        # mav rec fbc
XAI_API_KEY                 # mav fbc (the code also accepts GROK_API_KEY; this validator requires XAI_API_KEY)

# --- LLM and search for the v2 weekly run and GBP photo scoring
DEEPSEEK_API_KEY            # wk
SERPAPI_API_KEY             # wk
OPENAI_API_KEY              # gbp: gbp-photo-pick gpt-4o scoring (overrides the User env var, see audit 6.2)
SEARCH_CONSOLE_TOKEN_FILE   # wk rec: /opt/seo/secrets/grizzly-search-console.json

# --- GBP (API mode)
GBP_CLIENT_SECRET           # gbp: path to /opt/seo/secrets/client_secret_hermes_gbp.json
GBP_TOKEN_FILE              # gbp rec: path to /opt/seo/secrets/grizzly-gbp.json (must be writable by seo)
GBP_WORKBOOK_DIR            # gbp: /srv/seo/gbp (folder holding the workbook; replaces the Windows config_dir)
GBP_WORKBOOK_PATH           # gbp: /srv/seo/gbp/Grizzly GBP Schedule.xlsx
GBP_ARCHIVE_FOLDER          # gbp mon: /srv/seo/gbp-archive

# --- host network and host-only controls (B3, B8, B7)
MAV_BRIDGE_BIND             # mav: the ONE LXC address so CT 103 (MCC) can reach :8790; firewall to CT 103 only (hard gate E3); 0.0.0.0 is refused
MCC_HEALTH_URL              # mon: CT 103's MCC, http://<ct103-ip>:3000 (seo-monitor probes it; the default is loopback, where MCC is not)
SEO_MONITOR_NET_USE         # mon: 0 on AIWA (the `net use M:` remount is win32-only; on win32 it defaults on, 0 disables)
WEBSITE_BRANCH              # wk: main (website.py defaults to master; the live site serves main)

# --- photo intake (decision D3)
SEO_RCLONE_REMOTE           # ph: rclone remote name for the Drive "GBP Photos" folder
GBP_PHOTOS_FOLDER           # ph: /srv/seo/photos/inbox
GBP_PHOTOS_LOCAL_CACHE      # ph: /srv/seo/photos

# --- binaries and alert transport
SEO_AGENTS_EXE              # mav gbp: /opt/seo/.venv/bin/seo-agents
HERMES_CLI                  # mav gbp wk mon: absolute path to the hermes binary on this host
HERMES_ALERT_TO             # mon wd
SLACK_BOT_TOKEN             # mav: Slack alert transport (no %LOCALAPPDATA% fallback on Linux)
SLACK_ALERT_CHANNEL         # mav
SMTP_APP_PASSWORD           # wk mon
SMTP_FROM                   # mon
SMTP_TO                     # mon
