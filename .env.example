OPENAI_API_KEY=
SERPAPI_API_KEY=

# Supabase — REQUIRED by seo-monitor.mjs, supabase-sync.mjs, mav-bridge and the
# GBP/FB posters. The monitor exits immediately if these are unset.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Failure alerts — PRIMARY channel: `hermes send` CLI → MavH Twilio SMS.
# Target format: 'sms:+1XXXXXXXXXX', 'slack' (home channel), or 'slack:<channel-or-DM id>'
HERMES_ALERT_TO=sms:+14697169870
# HERMES_CLI=                          # path to hermes.exe if not the default install

# Failure alerts — SECONDARY (best-effort): Gmail SMTP (Google App Password, NOT account password)
# To create an app password: myaccount.google.com → Security → 2-Step Verification → App passwords
# Node monitor/watchdog read SMTP_FROM/SMTP_TO; the Python crew reads SMTP_FROM_EMAIL/SMTP_TO_EMAIL.
SMTP_APP_PASSWORD=
SMTP_FROM=barnscarter@gmail.com
SMTP_TO=barnscarter@gmail.com
# SMTP_FROM_EMAIL=barnscarter@gmail.com
# SMTP_TO_EMAIL=barnscarter@gmail.com

# Weekly-run watchdog (seo-monitor.mjs + seo-watchdog.mjs)
# SEO_RUN_DOW=5                        # expected run day-of-week, 0=Sun … 5=Fri
# SEO_NO_SHOW_DEADLINE=09:00           # local HH:mm — alert if the runner hasn't started by then
# SEO_WATCHDOG_STALE_DAYS=8            # alert if the last runner activity is older than this

# Venice Pro+ eval 2026-07
# REVERT: restore CREWAI_RESEARCH_MODEL to openai/gpt-4o-mini / openai/gpt-4o and remove the *_API_BASE overrides
CREWAI_RESEARCH_MODEL=zai-org-glm-5-2
CREWAI_RESEARCH_API_KEY=venice-pro-eval-key
CREWAI_RESEARCH_API_BASE=https://api.venice.ai/api/v1

CREWAI_EXEC_MODEL=deepseek-v4-pro
CREWAI_EXEC_API_KEY=venice-pro-eval-key
CREWAI_EXEC_API_BASE=https://api.venice.ai/api/v1

# Video generation
GROK_VIDEO_RESOLUTION=1080p
GRIZZLY_REFERENCE_IMAGES=assets/reference-images

# Default fallback — uncomment to revert:
# CREWAI_RESEARCH_MODEL=openai/gpt-4o-mini
# CREWAI_EXEC_MODEL=openai/gpt-4o

CREWAI_TEMPERATURE=0.2
CREWAI_VERBOSE=false

# Website / WordPress action adapter
WORDPRESS_SITE_CONFIG=C:\Workspace\Active\SEO-Agents-App\config\wordpress-sites\grizzly.json
WORDPRESS_ACTION_ADAPTER=C:\Workspace\Active\SEO-Agents-App\scripts\wordpress-action-adapter.mjs
WORDPRESS_BROWSER_SESSION_DIR=C:\Workspace\Shared\Agents\BrowserSessions\grizzly-wordpress

# GBP action adapter
GBP_POSTER_SCRIPT=C:\Users\carte\.claude\skills\gbp-poster\driver.mjs
GBP_POSTER_CONFIG=C:\Users\carte\.codex\plugins\grizzly-gbp-poster\config.local.json
GBP_BROWSER_SESSION_DIR=C:\Users\carte\.claude\gbp-session
# GBP_POSTER_TIMEOUT_S=420            # max seconds for a live browser post run
# GBP_POSTER_HEADLESS=0               # set 1 to run live GBP posts headless (no visible browser)
# WORDPRESS_ADAPTER_TIMEOUT_S=300

# Facebook poster (scripts/facebook-poster.mjs)
# Graph API is the primary path; Playwright is used ONLY when FB_USE_PLAYWRIGHT=1.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=                  # long-lived Page Access Token (developers.facebook.com/tools/explorer)
# FB_MEDIA_MODE=real                   # default: real job photos + Ken Burns slideshow Reels (no AI video)
# FB_MEDIA_MODE=ai                     # legacy: generative Grok/Veo video for TYPE video|slideshow
# FB_SLIDESHOW_AUDIO=assets/audio/slideshow-bed.mp3   # optional bed track; auto-generated if missing
# FB_SLIDESHOW_BEAT_SEC=2.7            # caption dwell time (seconds) after timeline compression
# FB_USE_PLAYWRIGHT=0                  # set 1 to post via browser automation instead of the Graph API
# FB_PAGE_URL=                         # only needed for Playwright; defaults to facebook.com/<FB_PAGE_ID>
# FB_GRAPH_API_VERSION=v22.0
# FACEBOOK_POSTER_ADAPTER=C:\Workspace\Active\SEO-Agents-App\scripts\facebook-poster.mjs
# FACEBOOK_POSTER_TIMEOUT_S=900        # allow >720s so a slow Veo 3 render + upload completes
# GEMINI_API_KEY=                      # optional; only needed if FB_MEDIA_MODE=ai (Veo) or image helpers
# VENICE_API_KEY=                       # fallback image backend for reference images (Venice flux-2-pro)
# GEMINI_VEO_MODEL=veo-3.0-generate-001
# FB_VIDEO_BACKEND=xai                 # only used when FB_MEDIA_MODE=ai
#
# ── Meta Marketing API boosts (scripts/fb-boost-api.mjs via mav-bridge) ──
# Ledger (fb-boost-ledger.mjs) remains the hard $50/week money gate.
# Live spend requires FB_BOOST_API=1 AND a configured ad account + token with ads_management.
# FB_BOOST_API=0                       # set 1 to allow live Marketing API spend (default: off)
# FB_AD_ACCOUNT_ID=                    # act_… from Meta Ads Manager / Business settings
# FB_ADS_ACCESS_TOKEN=                 # system user token with ads_management — used for ads WRITES
#                                      # BOTH tokens are required: page reads (published_posts, post
#                                      # verify) use FB_PAGE_ACCESS_TOKEN, because an ads/system-user
#                                      # token gets (#210) there. Falls back to the page token only if
#                                      # that token can manage ads.
# FB_BOOST_CAMPAIGN_ID=                # optional: reuse a standing campaign instead of creating one
# FB_BOOST_WEEKLY_CAP=50               # ledger hard cap (dollars)
# FB_BOOST_GEO_LAT=32.7767             # Dallas center (Carter standing override)
# FB_BOOST_GEO_LNG=-96.7970
# FB_BOOST_GEO_RADIUS_MI=20
# FB_BOOST_AGE_MIN=28
# FB_BOOST_AGE_MAX=65
# MAV_BRIDGE_FB_BOOST=1                # set 0 to skip daily boost tick in mav-bridge

# Executor completion reports: structured JSON (default) vs legacy markdown regex parsing
# CREWAI_STRUCTURED_COMPLETIONS=true

# Website task auto-execution (1 = enabled, 0 = disabled → manual review fallback)
MAV_WEBSITE_AUTO_EXEC=1

# Optional per-tier local routing (OpenAI-compatible server, e.g. llama-server)
# CREWAI_RESEARCH_API_BASE=http://127.0.0.1:8080/v1
# CREWAI_RESEARCH_API_KEY=local
# CREWAI_RESEARCH_MAX_TOKENS=2048
# CREWAI_EXEC_API_BASE=
# CREWAI_EXEC_API_KEY=
# CREWAI_EXEC_MAX_TOKENS=
